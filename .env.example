# Every variable Shopify Builder reads. Placeholder values only: the real ones live in
# /etc/builder/.env on the VPS (copied to .env.production.local by vps-setup/deploy.sh).
# Copy to .env.local for local development. Never commit a real value.

# ── Database (its own database, same PostgreSQL as ShipTrack) ──
DATABASE_URL=postgresql://builder_user:PASSWORD@localhost:5432/builder

# ── Public URL (OAuth redirect, image links Shopify downloads) ──
NEXT_PUBLIC_BASE_URL=https://merchantbuild.in

# ── The one login ─────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs login tokens: 32+ random characters (`openssl rand -hex 32`). Changing it signs out.
AUTH_TOKEN_SECRET=

# ── Store tokens at rest (AES-256-GCM) ────────────────────────
# 32 random bytes, base64 (`openssl rand -base64 32`). Without it no store can be connected
# or used (fail closed). Back it up: losing it means reconnecting every store.
BUILDER_DATA_KEY=

# ── Shopify app (Dev Dashboard, custom distribution) ──────────
# Redirect URL in the app: ${NEXT_PUBLIC_BASE_URL}/api/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: Admin API version (default in src/lib/shopify/client.ts)
SHOPIFY_API_VERSION=

# ── Uploads (product photos, banners, logos) ──────────────────
# Absolute folder outside the repo; served at /uploads/... (nginx in production).
UPLOADS_DIR=/var/www/builder-uploads

# ── AI (OpenRouter) ───────────────────────────────────────────
AI_API_KEY=
# Optional base URL (default https://openrouter.ai/api)
CODEX_URL=
# Optional: the text model tried first (default deepseek/deepseek-v4-flash)
AI_TEXT_MODEL=
# Optional: the image model (default google/gemini-2.5-flash-image)
AI_IMAGE_MODEL=
